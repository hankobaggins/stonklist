NEXT_PUBLIC_SITE_URL=https://stonklist.lol
NEXT_PUBLIC_TREASURY_WALLET=            # treasury PUBLIC key only. never the private key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (Supabase → API Keys); legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works
SUPABASE_SERVICE_ROLE_KEY=              # server only
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=                  # random 32 bytes; Helius sends it as the Authorization header
CRON_SECRET=                            # Vercel cron auth (Vercel sets Authorization: Bearer <this>)
GMGN_API_KEY=                           # optional, phase 4
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1
